{
    "appearance": {
        "transparency": {
            "enabled": false
        }
    },
    "bar": {
        "persistent": true
    },
    "dashboard": {
        "dragThreshold": 200,
        "showOnHover": true
    },
    "general": {
        "idle": {
            "lockBeforeSleep": false,
            "timeouts": [
                {
                    "enabled": true,
                    "idleAction": "dpms off",
                    "inhibitWhenAudio": false,
                    "inhibitWhenCharging": false,
                    "respectInhibitors": true,
                    "returnAction": "dpms on",
                    "timeout": 900
                }
            ]
        }
    },
    "launcher": {
        "favouriteApps": [
            "firefox",
            "foot",
            "org.flameshot.Flameshot"
        ]
    },
    "services": {
        "audioIncrement": 0.01
    },
    "session": {
        "commands": {
            "hibernate": [
                "systemctl",
                "suspend"
            ]
        },
        "icons": {
            "hibernate": "bedtime"
        }
    },
    "sidebar": {
        "enabled": true
    },
    "utilities": {
        "enabled": true,
        "quickToggles": [
            {
                "enabled": false,
                "id": "wifi"
            },
            {
                "enabled": true,
                "id": "bluetooth"
            },
            {
                "enabled": true,
                "id": "mic"
            },
            {
                "enabled": true,
                "id": "settings"
            },
            {
                "enabled": true,
                "id": "gameMode"
            },
            {
                "enabled": true,
                "id": "dnd"
            },
            {
                "enabled": false,
                "id": "vpn"
            }
        ]
    }
}
